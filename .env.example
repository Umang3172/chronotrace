# Provider selection.
#   reference-policy  hand-written test double, NOT a model. Default; needs no
#                     credentials. `repair --demo` refuses to run on it.
#   ollama            local model, e.g. qwen3:8b at CHRONOTRACE_OLLAMA_HOST
#   bedrock           Amazon Bedrock
#   fixture           replay recorded calls, no model contacted
CHRONOTRACE_PROVIDER=reference-policy
CHRONOTRACE_OLLAMA_MODEL=qwen2.5-coder:14b
CHRONOTRACE_TELEMETRY=jsonl
CHRONOTRACE_REGISTRY=sqlite
CHRONOTRACE_ISOLATION=process

# Filled in only when switching to Bedrock. Model ids differ by region and
# change between releases, so there is no default: look up the current id.
CHRONOTRACE_AWS_REGION=ap-south-1
CHRONOTRACE_MODEL_ID_SMALL=
CHRONOTRACE_MODEL_ID_LARGE=

# Budgets
CHRONOTRACE_RUN_TIMEOUT_S=30
CHRONOTRACE_GATE_TIMEOUT_S=5
CHRONOTRACE_STATISTICAL_RUNS=20
CHRONOTRACE_PCT_RUNS=0
